{
  "name": "transformo-docs",
  "productName": "Transformo Docs",
  "version": "0.1.0",
  "description": "Machine-readable document management for macOS",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "lint": "eslint .",
    "test": "vitest run",
    "backend:package": "cd ../backend && /opt/homebrew/bin/python3.11 -m PyInstaller backend.spec --noconfirm",
    "desktop:build": "vite build",
    "desktop:dist:mac": "npm run desktop:build && electron-builder --config electron-builder.yml --mac dmg"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
